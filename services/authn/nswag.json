{
  "runtime": "Net90",
  "defaultVariables": null,
  "documentGenerator": {
    "fromDocument": {
      "json": "specs/auth-separation_authn-api_v1.yaml"
    }
  },
  "codeGenerators": {
    "openApiToCSharpController": {
      "className": "AuthN",
      "namespace": "AuthSeparation.AuthN.Generated",
      "controllerStyle": "abstract",
      "controllerTarget": "AspNetCore",
      "useActionResultType": true,
      "generateClientInterfaces": false,
      "generateDtoTypes": true,
      "generateOptionalParameters": false,
      "output": "src/AuthSeparation.AuthN/Generated/AuthNController.g.cs"
    }
  }
}
